set -euo pipefail
# auto-go-build - cross-compile every binary artifact of the record for the TARGET_OS/TARGET_ARCH cell into its asset
# shellcheck source=/dev/null
. b19-i18n
TOOL="go-build"

if [[ $# -gt 0 ]]; then
    b19-log error "${TOOL}" "$(_p 'unknown argument %s, the artifact record says what to build' "$1")"
    exit 2
fi

os="${TARGET_OS:-${GOOS:-$(go env GOHOSTOS)}}"
arch="${TARGET_ARCH:-${GOARCH:-$(go env GOHOSTARCH)}}"
# The asset names the cell the way uname prints it there
case "${os}/${arch}" in
    darwin/arm64) uname_arch=arm64 ;;
    */amd64) uname_arch=x86_64 ;;
    */arm64) uname_arch=aarch64 ;;
    */386) uname_arch=i686 ;;
    *) uname_arch="${arch}" ;;
esac
ext=""
[[ "${os}" == windows ]] && ext=".exe"

version=""
for source in M6E_RELEASE_TAG GITHUB_REF_NAME M6E_VERSION git; do
    if [[ "${source}" == git ]]; then
        candidate="$(git describe --tags --always --dirty 2>/dev/null)" || candidate=""
    else
        candidate="${!source:-}"
    fi
    case "${candidate}" in
        '') continue ;;
        *[{}]*) b19-log warn "${TOOL}" "$(_p 'ignoring %s=%s, an unexpanded placeholder' "${source}" "${candidate}")"; continue ;;
    esac
    version="${candidate}"
    b19-log info "${TOOL}" "$(_p 'version %s from %s' "${version}" "${source}")"
    break
done
if [[ -z "${version}" ]]; then
    version=dev
    b19-log info "${TOOL}" "$(_p 'version %s, no ref, M6E_VERSION or git tag to read' "${version}")"
fi

# Flat lines read [i].key=value, so every field of one artifact shares its index
declare -A field=()
indexes=()
while IFS= read -r line; do
    [[ "${line}" == \[*\].*=* ]] || continue
    index="${line%%]*}"; index="${index#[}"
    key="${line#*].}"; key="${key%%=*}"
    field["${index}.${key}"]="${line#*=}"
    [[ "${key}" == path ]] && indexes+=("${index}")
done < <(pf-cli get --quiet --expand --format flat --default '' 'org.projectfile.artifacts{kind=binary}')
if [[ ${#indexes[@]} -eq 0 ]]; then
    b19-log warn "${TOOL}" "$(_p 'no kind: binary artifact in %s, nothing to build' "${PWD}")"
    exit 0
fi
project_os="$(pf-cli get --quiet --default '' org.projectfile.operating-system | paste --serial --delimiters=' ')"
project_arch="$(pf-cli get --quiet --default '' org.projectfile.architecture | paste --serial --delimiters=' ')"

retries="${B19_GO_DOWNLOAD_RETRIES:-3}"
attempt=1
until timeout "${B19_GO_DOWNLOAD_TIMEOUT:-300}" go mod download; do
    if (( attempt >= retries )); then
        b19-log error "${TOOL}" "$(_p 'go mod download failed %s times, giving up' "${attempt}")"
        exit 1
    fi
    delay=$(( 2 ** attempt + RANDOM % 3 ))
    b19-log warn "${TOOL}" "$(_p 'go mod download attempt %s failed, retrying in %s s' "${attempt}" "${delay}")"
    sleep "${delay}"
    attempt=$(( attempt + 1 ))
done

built=0
for index in "${indexes[@]}"; do
    path="${field[${index}.path]}"
    command="${field[${index}.command]:-$(basename "${path}")}"
    oses="${field[${index}.operating-system]:-${project_os}}"
    arches="${field[${index}.architecture]:-${project_arch}}"
    if [[ -n "${oses}" && " ${oses} " != *" ${os} "* ]] || [[ -n "${arches}" && " ${arches} " != *" ${arch} "* ]]; then
        b19-log info "${TOOL}" "$(_p '%s is not built for %s/%s, its record lists %s × %s' "${command}" "${os}" "${arch}" "${oses:-any}" "${arches:-any}")"
        continue
    fi
    excluded=no
    for (( j = 0; ; j++ )); do
        ex_os="${field[${index}.exclude[${j}].os]-}"
        ex_arch="${field[${index}.exclude[${j}].arch]-}"
        [[ -z "${ex_os}${ex_arch}" ]] && break
        [[ "${ex_os:-${os}}" == "${os}" && "${ex_arch:-${arch}}" == "${arch}" ]] && excluded=yes
    done
    if [[ "${excluded}" == yes ]]; then
        b19-log info "${TOOL}" "$(_p '%s excludes the %s/%s cell' "${command}" "${os}" "${arch}")"
        continue
    fi

    asset="${field[${index}.asset]:-{command\}-{os\}-{arch\}{ext\}}"
    asset="${asset//\{command\}/${command}}"
    asset="${asset//\{os\}/${os}}"
    asset="${asset//\{arch\}/${uname_arch}}"
    asset="${asset//\{ext\}/${ext}}"
    if [[ "${asset}" == *[{}]* ]]; then
        b19-log error "${TOOL}" "$(_p 'asset %s keeps a placeholder, only {command} {os} {arch} {ext} exist' "${asset}")"
        exit 1
    fi
    out="$(dirname "${path}")/${asset}"
    package="${field[${index}.package]:-.}"
    [[ "${package}" == .* || "${package}" == /* ]] || package="./${package}"
    symbol="${field[${index}.version-symbol]:-main.version}"

    mkdir --parents "$(dirname "${out}")"
    b19-log info "${TOOL}" "$(_p 'building %s %s for %s/%s from %s into %s' "${command}" "${version}" "${os}" "${arch}" "${package}" "${out}")"
    CGO_ENABLED=0 GOOS="${os}" GOARCH="${arch}" go build -trimpath \
        -ldflags="-s -w -X ${symbol}=${version}" -o "${out}" "${package}"
    built=$(( built + 1 ))
done

if [[ "${built}" -eq 0 ]]; then
    b19-log error "${TOOL}" "$(_p 'no binary artifact is built for %s/%s, the cell is outside the record' "${os}" "${arch}")"
    exit 1
fi
b19-log info "${TOOL}" "$(_p 'built %s binaries for %s/%s' "${built}" "${os}" "${arch}")"
